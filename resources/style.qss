    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-weight: bold;
}
QPushButton#FramelessBtnOk:hover {
    background: #1C97EA;
}
QPushButton#FramelessBtnOkConfirm {
    background: #E81123;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-weight: bold;
}
QPushButton#FramelessBtnOkConfirm:hover {
    background: #F42637;
}

/* 各 UI 面板专属组件选择器外联 */
QLabel#ContentPanelTitleLabel {
