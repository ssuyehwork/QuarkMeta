}
QPushButton#FilterGroupHdrBtn {
    background-color: transparent;
    color: #AAAAAA;
    font-size: 11px;
    font-weight: 600;
    border: none;
    outline: none;
    text-align: left;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 0px;
    padding-bottom: 0px;
    margin: 0px;
}
QPushButton#FilterGroupHdrBtn:hover {
    color: #EEEEEE;
    background-color: transparent;
}
QPushButton#FilterGroupHdrBtn:checked {
    background-color: transparent;
    color: #EEEEEE;
    border: none;
    outline: none;
}
QPushButton#FilterGroupHdrBtn:checked:hover {
    background-color: transparent;
    color: #FFFFFF;
}
QPushButton#FilterGroupHdrBtn:pressed {
    background-color: transparent;
    color: #EEEEEE;
}
QPushButton#FilterGroupHdrBtn:focus {
    background-color: transparent;
    outline: none;
}
QLabel#FilterItemLabel {
    font-size: 12px;
    color: #CCCCCC;
    background: transparent;
}
QLabel#FilterItemCountLabel {
    font-size: 11px;
    color: #555555;
    background: transparent;
}

/* ContentHeaderWidget 栏分割线 */
QWidget#ContentHeaderWidget {
    background-color: #252526;
    border-bottom: 1px solid #333333;
}



/* FilterPanel 分类圆点基础静态样式 */
QLabel#FilterItemDot {
    border-radius: 5px;
}

/* FilterPanel 标题标签基础静态样式 */
QLabel#FilterTitleLabel {
    font-size: 13px;
    font-weight: bold;
    background: transparent;
