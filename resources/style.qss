/* 全局基础样式 */
QMainWindow, QDialog { background-color: #1E1E1E; color: #EEEEEE; }
QWidget#CentralWidget { background-color: #1E1E1E; }

/* 标题栏与导航栏切割线 */
#TitleBar {
    background-color: #1E1E1E;
    border-bottom: 1px solid #333333;
}
#NavBar {
    background-color: #1E1E1E;
    border-bottom: none;
}

/* 卡片 5px 实体物理切缝 + Dual-mode 深色风格 */
QSplitter {
    background: transparent;
    border: none;
}
QSplitter::handle:horizontal {
    background-color: #1E1E1E;
    width: 5px;
}
QSplitter::handle:horizontal:hover {
    background-color: #378ADD;
}

/* 核心容器样式 - 彻底消除 margin，由 QSplitter 5px 句柄原生提供栏间 5px 物理间距，确保面板精确呈现 230px 物理满额宽度 */
#SidebarContainer, #FavoriteContainer, #ListContainer, #EditorContainer, #MetadataContainer, #FilterContainer {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 0px;
    color: #EEEEEE;
    margin: 0px;
    padding: 0px;
}

/* 容器标题栏样式 (回归绝对直角设计) */
#ContainerHeader {
    background-color: #252526;
    border-bottom: 1px solid #333333;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}

/* 批次二：顶层窗口与导航栏外联选择器 */
QLabel#TitleLogoLabel {
    background: transparent;
    border: none;
}
QLabel#AppNameLabel {
    color: #ff551c;
    font-size: 12px;
    font-weight: bold;
}
QWidget#BodyWrapper {
    background: transparent;
}
QPushButton#NavControlBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
}
QPushButton#NavControlBtn:hover {
    background: #3E3E42;
}
QPushButton#NavControlBtn:pressed {
    background: #4E4E52;
}
QPushButton#NavControlBtn:disabled {
    opacity: 0.3;
}
QPushButton#TitleControlBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0;
}
QPushButton#TitleControlBtn:hover {
    background: #3E3E42;
}
QPushButton#TitleControlBtn:pressed {
    background: #4E4E52;
}
QPushButton#TitleCloseBtn {
    background-color: #e81123;
    border: none;
    border-radius: 4px;
    padding: 0;
}
QPushButton#TitleCloseBtn:hover {
    background-color: #e81123;
}
QPushButton#TitleCloseBtn:pressed {
    background-color: #A50000;
}
QSlider#SizeSlider {
    background: transparent;
    margin-right: 5px;
}
QSlider#SizeSlider::groove:horizontal {
    height: 3px;
    background: #3F3F3F;
    border-radius: 2px;
}
QSlider#SizeSlider::sub-page:horizontal {
    background: #378ADD;
    border-radius: 2px;
}
QSlider#SizeSlider::handle:horizontal {
    width: 10px;
    height: 10px;
    background: #8E8E93;
    border-radius: 5px;
    margin: -3px 0;
}
QSlider#SizeSlider::handle:horizontal:hover {
    background: #CCCCCC;
}
QWidget#DriveBar {
    background-color: #252526;
    border-bottom: 1px solid #333333;
}
QPushButton#BtnTagManager {
    background-color: #252526;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 0 12px;
    color: #888888;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#BtnTagManager:hover {
    background-color: #3E3E42;
    border-color: #1abc9c;
    color: #FFFFFF;
}
QPushButton#BtnTagManager:pressed {
    background-color: #4E4E52;
}

QWidget#AddressContainer {
    background: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 6px;
}
QWidget#AddressContainer[focused='true'] {
    border: 1px solid #3498db;
}
QStackedWidget#AddressPathStack {
    background: transparent;
    border: none;
}
QLineEdit#AddressPathEdit {
    background: transparent;
    border: none;
    color: #EEEEEE;
    padding-left: 8px;
}
QPushButton#BtnRefreshAddress {
    background: transparent;
    border: none;
    border-left: 1px solid #333333;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QPushButton#BreadcrumbNodeBtn {
    background: transparent;
    border: none;
    outline: none;
    border-radius: 4px;
    color: #CCCCCC;
    font-size: 12px;
    padding: 0 4px;
}
QPushButton#BreadcrumbNodeBtn:hover {
    background: #3E3E42;
    color: #FFFFFF;
}
QPushButton#BreadcrumbNodeBtn:pressed {
    background: #4E4E52;
}
QLabel#BreadcrumbSep {
    background: transparent;
    border: none;
    padding: 0 1px;
}

QWidget#SearchContainer {
    background: transparent;
}
QLineEdit#SearchEdit {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 6px;
    color: #EEEEEE;
    padding-left: 28px;
    padding-right: 24px;
    font-size: 12px;
}
QLineEdit#SearchEdit:focus {
    border-color: #FDB70A;
}

QLabel#StatusBarLeft {
    font-size: 11px;
    color: #888888;
    background: transparent;
}
QLabel#StatusBarLeft[indexing='true'] {
    font-size: 11px;
    color: #378ADD;
    background: transparent;
    font-weight: bold;
}

/* 批次三：对话框、浮层与小组件选择器外联 */
QLabel#UndoToastMsgLabel {
    color: #EEEEEE;
    font-size: 12px;
    font-family: 'Segoe UI', 'Microsoft YaHei';
}
QPushButton#UndoToastBtnUndo {
    background-color: #378ADD;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 0 12px;
}
QPushButton#UndoToastBtnUndo:hover {
    background-color: #4a9ce8;
}
QPushButton#UndoToastBtnUndo:pressed {
    background-color: #2b73be;
}
QWidget#UndoToastSeparator {
    background-color: #4E4E52;
}
QPushButton#UndoToastBtnClose {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0;
}
QPushButton#UndoToastBtnClose:hover {
    background-color: #3E3E42;
}

QLabel#TaskProgressTitleLabel {
    color: #EEEEEE;
    font-size: 11px;
    font-weight: bold;
    background: transparent;
}
QProgressBar#TaskProgressBar {
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    background-color: #1E1E1E;
    text-align: center;
    color: transparent;
}
QProgressBar#TaskProgressBar::chunk {
    background-color: #378ADD;
    border-radius: 2px;
}
QLabel#TaskProgressDetailLabel {
    color: #888888;
    font-size: 11px;
    background: transparent;
}
QLabel#TaskProgressCountLabel {
    color: #378ADD;
    font-size: 11px;
    font-weight: bold;
    background: transparent;
}

QWidget#QLContainer {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 8px;
}
QLabel#QLEmptyPromptLabel {
    color: #888888;
    font-size: 16px;
    font-weight: bold;
    background: transparent;
}
QLabel#QLInfoLabel {
    color: #777;
}
QLabel#QLInfoLabelWarn {
    color: #FF8C00;
    font-weight: bold;
    font-size: 14px;
}
QWidget#QLGraphicsView {
    background: transparent;
    border: none;
}

QLineEdit#TagSelectorSearchEdit, QLineEdit#TagManagerSearchEdit {
    background: #1E1E1E;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 4px 8px;
    color: #EEEEEE;
    font-size: 12px;
}
QLineEdit#TagSelectorSearchEdit:focus, QLineEdit#TagManagerSearchEdit:focus {
    border-color: #378ADD;
}
QPushButton#TagSelectorToggleBtn, QPushButton#TagManagerToggleBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
}
QPushButton#TagSelectorToggleBtn:hover, QPushButton#TagManagerToggleBtn:hover {
    background-color: #3E3E42;
}
QListWidget#TagSelectorGroupList {
    background-color: transparent;
    border: none;
    outline: none;
    color: #CCCCCC;
    font-size: 12px;
}
QListWidget#TagSelectorGroupList::item {
    height: 26px;
    padding-left: 6px;
    border-radius: 4px;
}
QListWidget#TagSelectorGroupList::item:hover {
    background-color: #3E3E42;
    color: #FFFFFF;
}
QListWidget#TagSelectorGroupList::item:selected {
    background-color: #378ADD;
    color: #FFFFFF;
    font-weight: bold;
}
QWidget#TagSelectorGridWidget, QWidget#TagManagerContentWidget {
    background-color: #1E1E1E;
}
QScrollArea#TagSelectorScrollArea {
    border: 1px solid #333;
    background-color: #1E1E1E;
    border-radius: 4px;
}

QLabel#HistoryEmptyLabel {
    color: #666666;
    font-size: 12px;
    padding: 4px 8px;
}
QWidget#HistoryTitleRow {
    background: transparent;
}
QLabel#HistoryTitleLabel {
    color: #888888;
    font-size: 11px;
}
QPushButton#HistoryBtnClearAll {
    background: transparent;
    border: none;
    color: #888888;
    font-size: 11px;
}
QPushButton#HistoryBtnClearAll:hover {
