    color: #CCCCCC;
}
QPushButton#BtnCopyPath {
    background: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    color: #CCCCCC;
    font-size: 11px;
}
QPushButton#BtnCopyPath:hover {
    background: #333333;
    color: #FFFFFF;
}
QPushButton#BtnOpenLocation {
    background: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    color: #CCCCCC;
    font-size: 11px;
}
QPushButton#BtnOpenLocation:hover {
    background: #378ADD;
    border-color: #378ADD;
    color: #FFFFFF;
}
QLabel#MetaInfoKeyLabel {
    font-size: 11px;
    color: #888888;
}
QLabel#MetaInfoValueLabel {
    font-size: 11px;
    color: #CCCCCC;
    line-height: 1.4;
}
QWidget#MetaColorPill {
    background: transparent;
    border: none;
}

/* 统一全软件 QMenu 菜单 (包括托盘菜单与右键菜单) */
QMenu {
    background-color: #252526;
    color: #EEEEEE;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 4px;
}
/* TitleBarWidget 视图模式下拉菜单选中项静态属性 */
QMenu#TitleBarViewModeMenu::item:checked,
QMenu#TitleBarViewModeMenu::item:checked:selected {
    color: #ff551c;
}
QMenu#TitleBarViewModeMenu::indicator:checked {
    width: 14px;
    height: 14px;
    left: 4px;
}
QMenu::icon {
    margin-right: 10px;
}
QMenu::item {
    background-color: transparent;
    color: #EEEEEE;
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
    font-size: 12px;
}
QMenu::item:selected {
    background-color: #3E3E42;
    color: #FFFFFF;
}
QMenu::item:disabled {
    color: #666666;
    background-color: transparent;
}
QMenu::separator {
    height: 1px;
    background-color: #333333;
    margin: 4px 6px;
}

/* 底部状态栏 */
#StatusBar {
    background-color: #252525;
    border-top: 1px solid #333333;
}

/* 全局滚动条美化 (基于滚动条标准规范) */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #333333;
    min-height: 20px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: #444444;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    width: 0px;
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #333333;
    min-width: 20px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover {
    background: #444444;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    height: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* 统一复选框样式 */
QCheckBox { color: #EEEEEE; font-size: 12px; spacing: 5px; }
QCheckBox::indicator { width: 15px; height: 15px; border: 1px solid #444; border-radius: 2px; background: #1E1E1E; }
QCheckBox::indicator:hover { border: 1px solid #666; }
QCheckBox::indicator:checked { 
    border: 1px solid #378ADD; 
    background: #1E1E1E; 
    image: url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjMzc4QUREIiBzdHJva2Utd2lkdGg9IjMuNSIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cG9seWxpbmUgcG9pbnRzPSIyMCA2IDkgMTcgNCAxMiI+PC9wb2x5bGluZT48L3N2Zz4=);
}

/* 统一输入框与多行文本框样式 */
QLineEdit, QPlainTextEdit, QTextEdit {
    background: #252526;
    border: 1px solid #333333;
    border-radius: 4px;
    color: #EEEEEE;
    padding-left: 6px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #378ADD;
}

/* 全局 QComboBox 下拉框暗色规整 */
QComboBox {
    background-color: #252526;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 2px 8px;
    color: #EEEEEE;
    font-size: 12px;
}
QComboBox:hover {
    border-color: #444444;
}
QComboBox:focus {
    border-color: #378ADD;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: none;
}
QComboBox QAbstractItemView {
    background-color: #252526;
    border: 1px solid #333333;
    selection-background-color: #378ADD;
    selection-color: #FFFFFF;
    color: #EEEEEE;
    outline: 0;
    padding: 2px;
}

/* 全局 QGroupBox 分组框暗色规整 */
QGroupBox {
    color: #EEEEEE;
    border: 1px solid #333333;
    border-radius: 6px;
    margin-top: 8px;
    padding-top: 12px;
    font-size: 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #888888;
    background-color: #1E1E1E;
}

/* 全局 QRadioButton 单选框暗色规整 */
QRadioButton {
    color: #EEEEEE;
    font-size: 12px;
    spacing: 6px;
}
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border-radius: 8px;
    border: 1px solid #555555;
    background: transparent;
}
QRadioButton::indicator:hover {
    border-color: #888888;
}
QRadioButton::indicator:checked {
    border: 1px solid #CCCCCC;
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0 #FFFFFF, stop:0.45 #FFFFFF, stop:0.5 transparent, stop:1 transparent);
}

/* 全局 QSpinBox 数字框暗色规整 */
QSpinBox {
    background-color: #252526;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 2px 6px;
    color: #EEEEEE;
    font-size: 12px;
}
QSpinBox:focus {
    border-color: #378ADD;
}

/* 统一 QTreeView 列表视图暗色斑马纹与高亮 */
QTreeView {
    background-color: #1E1E1E;
    alternate-background-color: #252526;
    qproperty-alternateBase: #252526;
    color: #EEEEEE;
    border: none;
    outline: 0;
}
QTreeView::branch {
    background: transparent;
}
QTreeView::branch:has-children:closed {
    image: url(:/Icon/arrow_right.svg);
}
QTreeView::branch:has-children:open {
    image: url(:/Icon/arrow_down.svg);
}
QTreeView::item {
    height: 28px;
    border: none;
}
QTreeView::item:alternate {
    background-color: #252526;
}

/* TextExtensionDialog 文本扩展名设置弹窗 */
#TextExtBuiltInTitle, #TextExtCustomTitle {
    font-weight: bold;
    color: #CCCCCC;
    font-size: 13px;
}

#TextExtScrollArea {
    background-color: #1a1a1a;
    border: 1px solid #333333;
    border-radius: 6px;
}

#TextExtScrollContent, #TextExtBuiltInContainer {
    background-color: transparent;
}

#TextExtBuiltInCapsules {
    color: #888888;
    font-size: 12px;
}

#TextExtensionListWidget {
    background-color: #1e1e1e;
    border: 1px solid #333333;
    border-radius: 6px;
    color: #e0e0e0;
    padding: 4px;
}

#TextExtensionListWidget::item {
    padding: 6px 10px;
    border-radius: 4px;
}

#TextExtensionListWidget::item:selected {
    background-color: #005fb8;
    color: #ffffff;
}
