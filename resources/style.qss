/* 全局基础样式 */
QMainWindow, QDialog { background-color: #1E1E1E; color: #EEEEEE; }
QWidget#CentralWidget { background-color: #1E1E1E; }

/* 标题栏与导航栏切割线 */
#TitleBar {
    background-color: #1E1E1E;
    border-bottom: 1px solid #333333;
}
#NavBar {
    background-color: #1E1E1E;
    border-bottom: 1px solid #333333;
}

/* 卡片 5px 实体物理切缝 + Dual-mode 深色风格 */
QSplitter {
    background: transparent;
    border: none;
}
QSplitter::handle:horizontal {
    background-color: #1E1E1E;
    width: 1px;
}
QSplitter::handle:horizontal:hover {
    background-color: #378ADD;
}

/* 核心容器样式 - 强化 1 像素物理切割感及 5px 缝隙 */
#SidebarContainer, #FavoriteContainer, #ListContainer, #EditorContainer, #MetadataContainer, #FilterContainer {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 0px;
    color: #EEEEEE;
    margin: 0px 2px;
    padding: 0px;
}

/* 容器标题栏样式 (回归绝对直角设计) */
#ContainerHeader {
    background-color: #252526;
    border-bottom: 1px solid #333333;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}

/* 批次二：顶层窗口与导航栏外联选择器 */
QLabel#TitleLogoLabel {
    background: transparent;
    border: none;
}
QLabel#AppNameLabel {
    color: #ff551c;
    font-size: 12px;
    font-weight: bold;
}
QWidget#BodyWrapper {
    background: transparent;
}
QPushButton#NavControlBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
}
QPushButton#NavControlBtn:hover {
    background: #3E3E42;
}
QPushButton#NavControlBtn:pressed {
    background: #4E4E52;
}
QPushButton#NavControlBtn:disabled {
    opacity: 0.3;
}
QPushButton#TitleControlBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0;
}
QPushButton#TitleControlBtn:hover {
    background: #3E3E42;
}
QPushButton#TitleControlBtn:pressed {
    background: #4E4E52;
}
QPushButton#TitleCloseBtn {
    background-color: #e81123;
    border: none;
    border-radius: 4px;
    padding: 0;
}
QPushButton#TitleCloseBtn:hover {
    background-color: #e81123;
}
QPushButton#TitleCloseBtn:pressed {
    background-color: #A50000;
}
QSlider#SizeSlider {
    background: transparent;
    margin-right: 5px;
}
QSlider#SizeSlider::groove:horizontal {
    height: 3px;
    background: #3F3F3F;
    border-radius: 2px;
}
QSlider#SizeSlider::sub-page:horizontal {
    background: #378ADD;
    border-radius: 2px;
}
QSlider#SizeSlider::handle:horizontal {
    width: 10px;
    height: 10px;
    background: #8E8E93;
    border-radius: 5px;
    margin: -3px 0;
}
QSlider#SizeSlider::handle:horizontal:hover {
    background: #CCCCCC;
}
QWidget#DriveBar {
    background-color: #252526;
    border-bottom: 1px solid #333333;
}
QPushButton#BtnTagManager {
    background-color: #252526;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 0 12px;
    color: #888888;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#BtnTagManager:hover {
    background-color: #3E3E42;
    border-color: #1abc9c;
    color: #FFFFFF;
}
QPushButton#BtnTagManager:pressed {
    background-color: #4E4E52;
}

QWidget#AddressContainer {
    background: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 6px;
}
QWidget#AddressContainer[focused='true'] {
    border: 1px solid #3498db;
}
QStackedWidget#AddressPathStack {
    background: transparent;
    border: none;
}
QLineEdit#AddressPathEdit {
    background: transparent;
    border: none;
    color: #EEEEEE;
    padding-left: 8px;
}
QPushButton#BtnRefreshAddress {
    background: transparent;
    border: none;
    border-left: 1px solid #333333;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QPushButton#BreadcrumbNodeBtn {
    background: transparent;
    border: none;
    outline: none;
    border-radius: 4px;
    color: #CCCCCC;
    font-size: 12px;
    padding: 0 4px;
}
QPushButton#BreadcrumbNodeBtn:hover {
    background: #3E3E42;
    color: #FFFFFF;
}
QPushButton#BreadcrumbNodeBtn:pressed {
    background: #4E4E52;
}
QLabel#BreadcrumbSep {
    background: transparent;
    border: none;
    padding: 0 1px;
}

QWidget#SearchContainer {
    background: transparent;
}
QLineEdit#SearchEdit {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    border-radius: 6px;
    color: #EEEEEE;
    padding-left: 28px;
    padding-right: 24px;
    font-size: 12px;
}
QLineEdit#SearchEdit:focus {
    border-color: #FDB70A;
}

QLabel#StatusBarLeft {
    font-size: 11px;
    color: #888888;
    background: transparent;
}
QLabel#StatusBarLeft[indexing='true'] {
    font-size: 11px;
    color: #378ADD;
    background: transparent;
    font-weight: bold;
}

/* 各 UI 面板专属组件选择器外联 */
QLabel#ContentPanelTitleLabel {
    font-size: 13px;
    font-weight: bold;
    color: #41F2F2;
    background: transparent;
    border: none;
}
QPushButton#ViewModeToolBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
}
QPushButton#ViewModeToolBtn:hover, QPushButton#ViewModeToolBtn:checked {
    background: #3E3E42;
}

QLabel#NavPanelTitleLabel {
    color: #2ecc71;
    font-size: 13px;
    font-weight: bold;
    background: transparent;
    border: none;
}
QPushButton#NavTrashBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
}
QPushButton#NavTrashBtn:hover {
    background-color: #3E3E42;
}
QPushButton#NavTrashBtn:pressed {
    background-color: #4E4E52;
}

QLabel#FavoritePanelTitleLabel {
    color: #FDB70A;
    font-size: 13px;
    font-weight: bold;
    background: transparent;
    border: none;
}
QPushButton#FavPickerIconBtn {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
}
QPushButton#FavPickerIconBtn:hover {
    background-color: #3E3E42;
    border: 1px solid #555555;
}

QWidget#FilterContainerWidget, QWidget#FilterGroupWrapper, QWidget#FilterGroupContent {
    background: transparent;
}
QPushButton#FilterBtnClearAll {
    background: transparent;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    color: #888888;
    font-size: 11px;
    padding: 0 6px;
}
QPushButton#FilterBtnClearAll:hover {
    background: #3E3E42;
    color: #EEEEEE;
    border-color: #555555;
}
QPushButton#FilterBtnPin {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
}
QPushButton#FilterBtnPin:hover {
    background-color: #3E3E42;
}
QPushButton#FilterBtnPin:checked {
    background-color: #378ADD;
}
QPushButton#FilterBtnToggleGroups {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
}
QPushButton#FilterBtnToggleGroups:hover {
    background-color: #3E3E42;
}
QScrollArea#FilterScrollArea {
    border: none;
    background: transparent;
}
QLineEdit#FilterSearchEdit {
    background: #1E1E1E;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 2px 6px;
    color: #EEEEEE;
    font-size: 11px;
}
QLineEdit#FilterSearchEdit:focus {
    border-color: #378ADD;
}
QPushButton#FilterBtnSort {
    background: transparent;
    border: none;
}
QPushButton#FilterBtnSort:hover {
    background: #3E3E42;
    border-radius: 2px;
}
QLabel#FilterSepLabel {
    color: #AAA;
}
QWidget#FilterGroupHdrRow {
    background-color: #252526;
    border: 1px solid #333333;
    border-radius: 4px;
}
QPushButton#FilterGroupHdrBtn {
    background: transparent;
    color: #EEEEEE;
    font-size: 12px;
    font-weight: bold;
    border: none;
    text-align: left;
    padding-left: 4px;
}
QPushButton#FilterGroupHdrBtn:hover {
    color: #FFFFFF;
}
QPushButton#FilterGroupHdrBtn:checked {
    background: transparent;
    color: #EEEEEE;
    border: none;
}
QPushButton#FilterGroupHdrBtn:focus {
    outline: none;
}
QLabel#FilterItemLabel {
    font-size: 12px;
    color: #CCCCCC;
    background: transparent;
}
QLabel#FilterItemCountLabel {
    font-size: 11px;
    color: #555555;
    background: transparent;
}

/* 元数据面板专属组件选择器外联 */
QLabel#MetaPanelTitleLabel {
    font-size: 12px;
    font-weight: bold;
    color: #4a90e2;
    background: transparent;
    border: none;
}
QScrollArea#MetaScrollArea {
    border: none;
    background: transparent;
}
QWidget#TopPreviewBox {
    background: transparent;
    border: none;
}
QLabel#MetaImagePreview {
    background: transparent;
    border: none;
}
QTextEdit#MetaNameEdit {
    background: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 13px;
    font-weight: bold;
    color: #FFFFFF;
}
QTextEdit#MetaNameEdit:focus {
    border-color: #378ADD;
}
QTextEdit#MetaNameEdit:disabled {
    background: #1E1E1E;
    color: #777777;
    border-color: #2A2A2A;
}
QTextEdit#MetaNoteEdit {
    background: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
    color: #AAAAAA;
}
QTextEdit#MetaNoteEdit:focus {
    border-color: #378ADD;
    color: #FFFFFF;
}
QTextEdit#MetaNoteEdit:disabled {
    background: #1E1E1E;
    color: #555555;
}
QLineEdit#MetaLinkEdit {
    background: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding-left: 8px;
    font-size: 12px;
    color: #378ADD;
}
QLineEdit#MetaLinkEdit:focus {
    border-color: #378ADD;
}
QLineEdit#MetaLinkEdit:disabled {
    background: #1E1E1E;
    color: #555555;
}
QToolButton#MetaLinkToolBtn {
    border: none;
    border-left: 1px solid #3c3c3c;
    background: transparent;
    padding-left: 4px;
    padding-right: 4px;
}
QToolButton#MetaLinkToolBtn:hover {
    background: #3E3E42;
}
QPushButton#CollapsibleHeaderBtn {
    border: none;
    background: transparent;
    color: #888888;
    font-size: 11px;
    font-weight: bold;
    text-align: left;
    padding: 0;
}
QPushButton#CollapsibleHeaderBtn:hover {
    color: #FFFFFF;
}
QWidget#MetaRatingRow, QWidget#MetaColorRow {
    background: transparent;
    border: none;
}
QPushButton#MetaBtnClearStar, QPushButton#MetaBtnNoColor {
    border: none;
    background: transparent;
}
QPushButton#MetaBtnClearStar:hover, QPushButton#MetaBtnNoColor:hover {
    background: #333333;
    border-radius: 4px;
}
QPushButton#MetaBtnStar {
    border: none;
    background: transparent;
}
QPushButton#MetaBtnStar:hover {
    background: #333333;
    border-radius: 3px;
}
QPushButton#BtnAddTagBig {
    background-color: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 0 10px;
    color: #AAAAAA;
    font-size: 12px;
    text-align: center;
}
QPushButton#BtnAddTagBig:hover {
    background-color: #2a2d2e;
    border-color: #378ADD;
    color: #FFFFFF;
}
QPushButton#BtnAddTagBig:disabled {
    background: #1E1E1E;
    color: #555555;
}
QPushButton#BtnAddTagSmall {
    background-color: #2D2D30;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 0;
}
QPushButton#BtnAddTagSmall:hover {
    background-color: #378ADD;
    border-color: #378ADD;
}
QLineEdit#MetaPathEdit {
    background: #1E1E1E;
    border: 1px solid #2A2A2A;
    border-radius: 4px;
    padding: 4px 6px;
    font-size: 11px;
    color: #CCCCCC;
}
QPushButton#BtnCopyPath {
    background: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    color: #CCCCCC;
    font-size: 11px;
}
QPushButton#BtnCopyPath:hover {
    background: #333333;
    color: #FFFFFF;
}
QPushButton#BtnOpenLocation {
    background: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    color: #CCCCCC;
    font-size: 11px;
}
QPushButton#BtnOpenLocation:hover {
    background: #378ADD;
    border-color: #378ADD;
    color: #FFFFFF;
}
QLabel#MetaInfoKeyLabel {
    font-size: 11px;
    color: #888888;
}
QLabel#MetaInfoValueLabel {
    font-size: 11px;
    color: #CCCCCC;
    line-height: 1.4;
}
QWidget#MetaColorPill {
    background: transparent;
    border: none;
}

/* 统一全软件 QMenu 菜单 (包括托盘菜单与右键菜单) */
QMenu {
    background-color: #252526;
    color: #EEEEEE;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    background-color: transparent;
    color: #EEEEEE;
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
    font-size: 12px;
}
QMenu::item:selected {
    background-color: #3E3E42;
    color: #FFFFFF;
}
QMenu::item:disabled {
    color: #666666;
    background-color: transparent;
}
QMenu::separator {
    height: 1px;
    background-color: #333333;
    margin: 4px 6px;
}

/* 底部状态栏 */
#StatusBar {
    background-color: #252525;
    border-top: 1px solid #333333;
}

/* 全局滚动条美化 (基于滚动条标准规范) */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #333333;
    min-height: 20px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: #444444;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    width: 0px;
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #333333;
    min-width: 20px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover {
    background: #444444;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    height: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* 统一复选框样式 */
QCheckBox { color: #EEEEEE; font-size: 12px; spacing: 5px; }
QCheckBox::indicator { width: 15px; height: 15px; border: 1px solid #444; border-radius: 2px; background: #1E1E1E; }
QCheckBox::indicator:hover { border: 1px solid #666; }
QCheckBox::indicator:checked { 
    border: 1px solid #378ADD; 
    background: #1E1E1E; 
    image: url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjMzc4QUREIiBzdHJva2Utd2lkdGg9IjMuNSIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cG9seWxpbmUgcG9pbnRzPSIyMCA2IDkgMTcgNCAxMiI+PC9wb2x5bGluZT48L3N2Zz4=);
}

/* 统一输入框与多行文本框样式 */
QLineEdit, QPlainTextEdit, QTextEdit {
    background: #252526;
    border: 1px solid #333333;
    border-radius: 4px;
    color: #EEEEEE;
    padding-left: 6px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #378ADD;
}

/* 统一 QTreeView 列表视图暗色斑马纹与高亮 */
QTreeView {
    background-color: #1E1E1E;
    alternate-background-color: #252526;
    qproperty-alternateBase: #252526;
    color: #EEEEEE;
    border: none;
    outline: 0;
}
QTreeView::item {
    height: 28px;
    border: none;
}
QTreeView::item:alternate {
    background-color: #252526;
}
QTreeView::item:hover {
    background-color: #2A2D2E;
}
QTreeView::item:selected {
    background-color: rgba(55, 138, 221, 0.3);
    color: #FFFFFF;
}
