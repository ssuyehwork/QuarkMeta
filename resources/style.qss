    color: #E81123;
    border-color: #E81123;
}
QGroupBox#BatchRenameRulesGroup {
    padding-top: 15px;
    margin-top: 5px;
}
QGroupBox#BatchRenameRulesGroup::title {
    top: -2px;
    left: 8px;
}
QScrollArea#BatchRenameScroll {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}
QPushButton#BatchRenameExecuteBtn {
    background-color: #007ACC;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 13px;
