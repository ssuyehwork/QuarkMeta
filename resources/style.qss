}
QLineEdit#RuleTextEdit, QSpinBox#RuleStartSpin {
    background: #1E1E1E;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 2px 5px;
    color: #EEE;
}
QPushButton#RuleDeleteBtn {
    background: transparent;
    border: none;
    border-radius: 3px;
}
QPushButton#RuleDeleteBtn:hover {
    background-color: #3E3E42;
}

QWidget#ClickableRowActive {
    background: #2A2A2A;
    border-radius: 4px;
}
QWidget#ClickableRowNormal {
    background: transparent;
}
QLabel#TagPillLabel {
    color: #EEEEEE;
    font-size: 12px;
    border: none;
    background: transparent;
}
QPushButton#TagPillCloseBtn {
    border: none;
    background: transparent;
    padding: 0px;
}
QPushButton#TagPillCloseBtn:hover {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 7px;
}

QLineEdit#MetaInfoPathEdit {
    background: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 4px 6px;
    font-size: 11px;
    color: #CCCCCC;
}

QLabel#FramelessInputLabel, QLabel#FramelessConfirmLabel {
    color: #EEEEEE;
    font-size: 13px;
}
QLineEdit#FramelessInputEdit {
    background: #1E1E1E;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    padding: 6px;
    color: #EEEEEE;
    font-size: 12px;
}
QLineEdit#FramelessInputEdit:focus {
    border-color: #007ACC;
}
QPushButton#FramelessBtnCancel {
    background: transparent;
    color: #BBB;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 6px 16px;
}
QPushButton#FramelessBtnCancel:hover {
    background: #3E3E42;
}
QPushButton#FramelessBtnOk {
    background: #007ACC;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-weight: bold;
}
QPushButton#FramelessBtnOk:hover {
    background: #1C97EA;
}
QPushButton#FramelessBtnOkConfirm {
    background: #E81123;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-weight: bold;
}
QPushButton#FramelessBtnOkConfirm:hover {
    background: #F42637;
}

/* 各 UI 面板专属组件选择器外联 */
QLabel#ContentPanelTitleLabel {
    font-size: 13px;
    font-weight: bold;
    color: #41F2F2;
